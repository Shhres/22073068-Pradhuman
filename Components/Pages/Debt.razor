﻿
@page "/Debt"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="max-w-lg mx-auto mt-10 p-8 bg-white shadow-xl rounded-xl border border-gray-200">
    <h2 class="text-3xl font-bold mb-6 text-center text-indigo-700">Add Debt</h2>

    <!-- Loan Amount Section -->
    <div class="mb-5 relative">
        <label for="loanAmount" class="block text-lg font-medium text-gray-800">Loan Amount</label>
        <input type="number" id="loanAmount" @bind="LoanAmount" min="1" step="any"
               class="mt-2 w-full px-4 py-3 border-2 border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 placeholder-gray-500"
               placeholder="Enter loan amount" required
               @oninput="ValidateLoanAmount" />

        <!-- Hover Message for Negative Values -->
        @if (showNegativeValueError)
        {
      
        }
    </div>

    <!-- Description Section -->
    <div class="mb-5 relative">
        <label for="description" class="block text-lg font-medium text-gray-800">Description</label>
        <textarea id="description" @bind="Description" rows="4"
                  class="mt-2 w-full px-4 py-3 border-2 border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 placeholder-gray-500"
                  placeholder="Enter a brief description" required />
        @if (string.IsNullOrEmpty(Description))
        {
          
        }
    </div>

    <!-- Loan Date Section -->
    <div class="mb-5">
        <label for="loanDate" class="block text-lg font-medium text-gray-800">Loan Date</label>
        <input type="date" id="loanDate" @bind="LoanDate"
               class="mt-2 w-full px-4 py-3 border-2 border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 placeholder-gray-500"
               required />
    </div>

    <!-- Submit Button -->
    <div>
        <button @onclick="HandleSubmit"
                class="w-full bg-indigo-600 text-white py-3 px-6 rounded-md shadow-md hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-500 transform hover:scale-105 transition-all duration-300">
            Submit
        </button>
    </div>
</div>

@code {
    private decimal LoanAmount { get; set; }
    private string Description { get; set; } = string.Empty;
    private DateTime LoanDate { get; set; } = DateTime.Now;
    private bool showNegativeValueError { get; set; } = false;

    // Validate the loan amount for negative values
    private void ValidateLoanAmount()
    {
        if (LoanAmount <= 0)
        {
            showNegativeValueError = true;
        }
        else
        {
            showNegativeValueError = false;
        }
    }

    private async Task HandleSubmit()
    {
        // Check if form is complete and validate the fields
        if (LoanAmount <= 0 || string.IsNullOrEmpty(Description))
        {
            // Show a message if fields are empty
            await JS.InvokeVoidAsync("alert", "Please fill out all the fields before submitting.");
            return;
        }

        // Show a success message
        await JS.InvokeVoidAsync("alert", "Loan taken successfully!");

        // Navigate to the dashboard after the user clicks "OK"
        Navigation.NavigateTo("/dashboard");
    }
}