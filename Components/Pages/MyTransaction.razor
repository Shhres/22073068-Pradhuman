
@page "/mytransaction"
@using MauiApp1.Models
@using System.Text
@inject UserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h1 class="text-5xl font-extrabold text-center text-blue-700 mb-10">User Transactions</h1>

<!-- Search Form -->
<div class="bg-gray-100 p-6 rounded-lg shadow-md mb-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Tags Search -->
        <div>
            <label for="tags" class="block text-sm font-medium text-gray-800">Tags</label>
            <input id="tags" type="text" class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 focus:outline-none"
                   placeholder="Search by Tags" @bind="TagsSearch" />
        </div>

        <!-- Start Date -->
        <div>
            <label for="startDate" class="block text-sm font-medium text-gray-800">Start Date</label>
            <input id="startDate" type="date" class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 focus:outline-none"
                   @bind="StartDate" />
        </div>

        <!-- End Date -->
        <div>
            <label for="endDate" class="block text-sm font-medium text-gray-800">End Date</label>
            <input id="endDate" type="date" class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 focus:outline-none"
                   @bind="EndDate" />
        </div>

        <!-- Transaction Type -->
        <div>
            <label for="transactionType" class="block text-sm font-medium text-gray-800">Transaction Type</label>
            <select id="transactionType" class="w-full px-4 py-2 mt-1 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-400 focus:outline-none"
                    @bind="TransactionType">
                <option value="">All</option>
                <option value="Debit">Debit</option>
                <option value="Credit">Credit</option>
            </select>
        </div>
    </div>

    <!-- Search Button -->
    <div class="mt-6 text-center">
        <button class="bg-blue-600 text-white px-8 py-2 rounded-lg shadow-md hover:bg-blue-700 focus:ring-2 focus:ring-blue-300"
                @onclick="SearchTransactions">
            Search
        </button>
    </div>
</div>

<!-- Export Button -->
<div class="absolute top-10 right-10">
    <button class="bg-green-600 text-white px-8 py-2 rounded-lg shadow-md hover:bg-green-700 focus:ring-2 focus:ring-green-300"
            @onclick="ExportTransactions">
        Export
    </button>
</div>

<!-- Import Button -->
<div class="absolute top-10 right-40 flex items-center space-x-4">
    <button class="bg-yellow-600 text-white px-8 py-2 rounded-lg shadow-md hover:bg-yellow-700 focus:ring-2 focus:ring-yellow-300"
            @onclick="TriggerFileInput">
        Import
    </button>

    <!-- Hidden File Input -->
    <InputFile id="fileInput" OnChange="OnFileSelected" style="display: none;" />
</div>

<!-- Transactions Table -->
@if (FilteredTransactions.Any())
{
    <div class="overflow-x-auto bg-white shadow-md rounded-lg">
        <table class="min-w-full border-collapse border border-gray-200">
            <thead class="bg-blue-100">
                <tr>
                    <th class="px-4 py-2 border border-gray-300 text-left text-sm font-semibold text-gray-800">Tags</th>
                    <th class="px-4 py-2 border border-gray-300 text-left text-sm font-semibold text-gray-800">Debit</th>
                    <th class="px-4 py-2 border border-gray-300 text-left text-sm font-semibold text-gray-800">Credit</th>
                    <th class="px-4 py-2 border border-gray-300 text-left text-sm font-semibold text-gray-800">Date</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @foreach (var transaction in FilteredTransactions)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-2 border border-gray-300 text-sm text-gray-800">@transaction.Tags</td>
                        <td class="px-4 py-2 border border-gray-300 text-sm text-red-600">@transaction.Debit.ToString("C")</td>
                        <td class="px-4 py-2 border border-gray-300 text-sm text-green-600">@transaction.Credit.ToString("C")</td>
                        <td class="px-4 py-2 border border-gray-300 text-sm text-gray-800">@transaction.Date.ToString("MM/dd/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (ShowNoResultsModal)
{
    <!-- No Results Modal -->
    <div class="fixed inset-0 bg-gray-800 bg-opacity-50 flex justify-center items-center">
        <div class="bg-white p-8 rounded-lg shadow-lg">
            <h2 class="text-2xl font-bold text-red-600 text-center">No Results Found</h2>
            <p class="mt-4 text-center text-gray-700">We couldn't find any transactions matching your search criteria.</p>
            <div class="mt-6 text-center">
                <button class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700" @onclick="CloseModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private AppData Data;
    private string TagsSearch { get; set; }
    private DateTime? StartDate { get; set; }
    private DateTime? EndDate { get; set; }
    private string TransactionType { get; set; } = "";

    private bool ShowNoResultsModal { get; set; } = false;
    private decimal TotalDebit { get; set; } = 0;
    private decimal TotalCredit { get; set; } = 0;

    private IEnumerable<Transaction> FilteredTransactions =>
        Data.Transactions
            .Where(t =>
                (string.IsNullOrEmpty(TagsSearch) || t.Tags.Contains(TagsSearch, StringComparison.OrdinalIgnoreCase)) &&
                (!StartDate.HasValue || t.Date.Date >= StartDate.Value.Date) &&
                (!EndDate.HasValue || t.Date.Date <= EndDate.Value.Date) &&
                (string.IsNullOrEmpty(TransactionType) ||
                 (TransactionType == "Debit" && t.Debit > 0) ||
                 (TransactionType == "Credit" && t.Credit > 0))
            );

    protected override void OnInitialized()
    {
        Data = UserService.LoadData();
    }

    private void SearchTransactions()
    {
        TotalDebit = FilteredTransactions.Sum(t => t.Debit);
        TotalCredit = FilteredTransactions.Sum(t => t.Credit);

        ShowNoResultsModal = !FilteredTransactions.Any() && !string.IsNullOrEmpty(TagsSearch);

        StateHasChanged();
    }

    private void ExportTransactions()
    {
        StringBuilder csvContent = new StringBuilder();
        csvContent.AppendLine("Tags, Debit, Credit, Date");

        foreach (var transaction in FilteredTransactions)
        {
            csvContent.AppendLine($"{transaction.Tags}, {transaction.Debit:C}, {transaction.Credit:C}, {transaction.Date:MM/dd/yyyy}");
        }

        JS.InvokeVoidAsync("createDownloadLink", csvContent.ToString(), "transactions.csv");
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream();
        using var reader = new StreamReader(stream);
        var content = await reader.ReadToEndAsync();
        ParseCsvAndAddTransactions(content);
    }

    private void TriggerFileInput()
    {
        JS.InvokeVoidAsync("triggerFileInput");
    }

    private void ParseCsvAndAddTransactions(string csvContent)
    {
        var lines = csvContent.Split('\n').Skip(1); // Skip header
        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line)) continue;
            var values = line.Split(',');
            var transaction = new Transaction
                {
                    Id = Guid.NewGuid(),
                    Tags = values[0].Trim(),
                    Debit = decimal.Parse(values[1].Trim(), System.Globalization.NumberStyles.Currency),
                    Credit = decimal.Parse(values[2].Trim(), System.Globalization.NumberStyles.Currency),
                    Date = DateTime.Parse(values[3].Trim())
                };
            Data.Transactions.Add(transaction);
        }
        StateHasChanged();
    }

    private void CloseModal()
    {
        ShowNoResultsModal = false;
    }
}
