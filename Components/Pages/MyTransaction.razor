@page "/mytransaction"
@using MauiApp1.Models
@inject UserService UserService
@inject NavigationManager Navigation

<h1 class="text-4xl font-semibold mb-8 text-center text-blue-600">User Transactions</h1>

<!-- Search Form -->
<div class="mb-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Transaction ID Search -->
    <div>
        <label for="transactionId" class="block text-sm font-medium text-gray-700">Transaction ID</label>
        <input id="transactionId" type="text" class="w-full mt-1 px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
               placeholder="Search by ID" @bind="TransactionIdSearch" />
    </div>

    <!-- Title Search -->
    <div>
        <label for="title" class="block text-sm font-medium text-gray-700">Title</label>
        <input id="title" type="text" class="w-full mt-1 px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
               placeholder="Search by Title" @bind="TitleSearch" />
    </div>

    <!-- Tags Search -->
    <div>
        <label for="tags" class="block text-sm font-medium text-gray-700">Tags</label>
        <input id="tags" type="text" class="w-full mt-1 px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
               placeholder="Search by Tags" @bind="TagsSearch" />
    </div>

    <!-- Date Search -->
    <div>
        <label for="date" class="block text-sm font-medium text-gray-700">Date</label>
        <input id="date" type="date" class="w-full mt-1 px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
               @bind="DateSearch" />
    </div>

    <!-- Search Button -->
    <div class="col-span-full">
        <button class="w-full sm:w-auto bg-blue-600 text-white rounded-md px-6 py-3 mt-4 hover:bg-blue-700 focus:ring-2 focus:ring-blue-300" @onclick="SearchTransactions">Search</button>
    </div>
</div>

<!-- Transactions Table -->
<div class="overflow-x-auto shadow-lg rounded-lg bg-white">
    <table class="min-w-full table-auto">
        <thead class="bg-blue-100 border-b-2 border-gray-200">
            <tr>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Transaction ID</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Title</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Tags</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Debit</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Credit</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Date</th>
                <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Description</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var transaction in FilteredTransactions)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm text-gray-700">@transaction.Id</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@transaction.Title</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@transaction.Tags</td>
                    <td class="px-4 py-3 text-sm text-red-600">@transaction.Debit.ToString("C")</td>
                    <td class="px-4 py-3 text-sm text-green-600">@transaction.Credit.ToString("C")</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@transaction.Date.ToString("MM/dd/yyyy")</td>
                    <td class="px-4 py-3 text-sm text-gray-700">@transaction.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- No Results Modal -->
@if (ShowNoResultsModal)
{
    <div class="fixed inset-0 bg-gray-500 bg-opacity-50 flex justify-center items-center z-50">
        <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-xl font-bold text-center text-red-600">No Results Found</h2>
            <p class="mt-4 text-center text-gray-700">We couldn't find any transactions matching your search criteria.</p>
            <div class="mt-4 text-center">
                <button class="px-6 py-2 bg-red-600 text-white rounded-md hover:bg-red-700" @onclick="CloseModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private AppData Data;
    private string TransactionIdSearch { get; set; }
    private string TitleSearch { get; set; }
    private string TagsSearch { get; set; }
    private DateTime? DateSearch { get; set; }

    private bool ShowNoResultsModal { get; set; } = false;

    private IEnumerable<Transaction> FilteredTransactions =>
        Data.Transactions
            .Where(t =>
                (string.IsNullOrEmpty(TransactionIdSearch) || t.Id.ToString().Contains(TransactionIdSearch, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(TitleSearch) || t.Title.Contains(TitleSearch, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(TagsSearch) || t.Tags.Contains(TagsSearch, StringComparison.OrdinalIgnoreCase)) &&
                (!DateSearch.HasValue || t.Date.Date == DateSearch.Value.Date)
            );

    protected override void OnInitialized()
    {
        Data = UserService.LoadData();
    }

    private void SearchTransactions()
    {
        if (!FilteredTransactions.Any())
        {
            ShowNoResultsModal = true; // Show the modal if no results are found
        }
        StateHasChanged(); // Trigger re-render for filtered data
    }

    private void CloseModal()
    {
        ShowNoResultsModal = false; // Close the modal when the close button is clicked
    }
}
